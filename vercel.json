{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/Vikas_Bhardwaj_Resume.html",
      "destination": "/api/resume/html",
      "permanent": false
    },
    {
      "source": "/Vikas_Bhardwaj_Resume.txt",
      "destination": "/api/resume/text",
      "permanent": false
    },
    {
      "source": "/resume/Vikas_Bhardwaj_Resume.html",
      "destination": "/api/resume/html",
      "permanent": false
    },
    {
      "source": "/resume/Vikas_Bhardwaj_Resume.txt",
      "destination": "/api/resume/text",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/admin",
      "destination": "/api/page?admin=1"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/page?admin=1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
