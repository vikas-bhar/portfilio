# Server-only CMS configuration. Never use a VITE_ prefix for any secret.
# Local development works without these: it uses private .portfolio-data/ files.
# Vercel REQUIRES a PRIVATE Blob store; attaching it supplies this token.
# BLOB_READ_WRITE_TOKEN=

# Vercel first-run setup: generate a unique key with at least 32 characters.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ADMIN_SETUP_KEY=

# Optional namespace when multiple sites/environments use one private store.
# By default: portfolio-cms/<VERCEL_ENV or development>/v1
# Never point preview/development at the production namespace.
# PORTFOLIO_BLOB_PREFIX=portfolio-cms/development/v1

# Optional private directory for a persistent non-Vercel Node host.
# This must NOT be inside public/ or dist/.
# PORTFOLIO_DATA_DIR=.portfolio-data
